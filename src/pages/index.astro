---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="relative isolate min-h-screen overflow-hidden bg-[#f5f1e8] px-6 py-6 sm:px-10 lg:px-16">
		<div class="pointer-events-none absolute -right-36 -top-20 -z-10 h-[34rem] w-[34rem] rotate-12 bg-[url('/flower.png')] bg-[length:14rem_14rem] opacity-[0.12] sm:opacity-[0.17]"
			aria-hidden="true">
		</div>
		<div class="pointer-events-none absolute -bottom-48 -left-48 -z-10 h-[40rem] w-[40rem] -rotate-12 bg-[url('/flower.png')] bg-[length:18rem_18rem] opacity-[0.1]"
			aria-hidden="true">
		</div>

		<header class="mx-auto flex max-w-7xl items-center justify-between">
			<a href="/" class="group flex items-center gap-3" aria-label="Flowtea Studio home">
				<img src="/flowtea-logo.png" alt="Flowtea Studio" class="h-14 w-auto mix-blend-multiply transition-transform duration-300 group-hover:-rotate-3" />
			</a>
			<a href="#contact" class="rounded-full border border-[#385f9d] px-4 py-2 text-xs font-bold uppercase tracking-[0.16em] transition-colors hover:bg-[#385f9d] hover:text-[#f5f1e8]">
				Let's talk
			</a>
		</header>

		<section class="relative mx-auto flex min-h-[calc(100vh-7rem)] max-w-7xl items-center justify-center overflow-hidden pb-16 pt-12">
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<img src="/flower.png" class="absolute left-[8%] top-[13%] w-10 -rotate-12 opacity-80 sm:w-16" />
				<img src="/flower.png" class="absolute left-[19%] top-[34%] w-5 rotate-45 opacity-70 sm:w-8" />
				<img src="/flower.png" class="absolute left-[5%] top-[68%] w-16 rotate-[28deg] opacity-90 sm:w-24" />
				<img src="/flower.png" class="absolute left-[28%] top-[12%] w-7 -rotate-[25deg] opacity-75 sm:w-10" />
				<img src="/flower.png" class="absolute left-[35%] top-[76%] w-8 rotate-12 opacity-80 sm:w-12" />
				<img src="/flower.png" class="absolute right-[29%] top-[14%] w-12 rotate-[22deg] opacity-75 sm:w-20" />
				<img src="/flower.png" class="absolute right-[18%] top-[39%] w-6 -rotate-45 opacity-70 sm:w-10" />
				<img src="/flower.png" class="absolute right-[7%] top-[16%] w-20 rotate-[18deg] opacity-90 sm:w-28" />
				<img src="/flower.png" class="absolute right-[5%] top-[71%] w-12 -rotate-12 opacity-80 sm:w-20" />
				<img src="/flower.png" class="absolute left-[17%] top-[83%] w-6 rotate-45 opacity-60 sm:w-9" />
				<img src="/flower.png" class="absolute right-[36%] top-[80%] w-7 rotate-[60deg] opacity-60 sm:w-11" />
				<img src="/flower.png" class="absolute left-[47%] top-[6%] w-5 -rotate-12 opacity-60 sm:w-8" />
			</div>

			<div class="relative z-10 flex max-w-5xl flex-col items-center text-center">
				<p class="mb-8 rotate-[-3deg] text-xs font-bold uppercase tracking-[0.3em] text-[#bd272d] sm:text-sm">
					Independent creative studio
				</p>
				<h1 class="font-black text-[clamp(5rem,18vw,15rem)] uppercase leading-[0.7] tracking-[-0.11em] text-[#385f9d] [font-family:'Wilko','Arial_Rounded_MT_Bold','Arial_Black',Arial,sans-serif]">
					Flow<span class="text-[#bd272d]">Tea</span>
				</h1>
				<div class="mt-12 flex max-w-2xl flex-col items-center gap-7">
					<p class="max-w-md rotate-[1deg] text-lg leading-relaxed text-[#385f9d]/80 sm:text-xl">
						A small studio for big ideas. We grow identities, images and projects with the calm of a good cup of tea.
					</p>
					<div class="flex flex-wrap items-center justify-center gap-4">
						<a
							href="#studio"
							class="rounded-full bg-[#385f9d] px-7 py-4 text-sm font-bold uppercase tracking-[0.14em] text-[#f5f1e8] transition-transform hover:-translate-y-1 hover:rotate-2"
						>Discover the studio <span class="ml-3">↘</span></a>
						<span class="text-xs font-bold uppercase tracking-[0.18em] text-[#385f9d]/60">Est. 2024 · Milan / everywhere</span>
					</div>
				</div>
			</div>
		</section>

		<section class="relative mx-auto grid max-w-7xl gap-8 overflow-hidden rounded-[2.5rem] border-2 border-[#385f9d] bg-[#f7cf35] px-7 py-12 shadow-[10px_10px_0_#385f9d] sm:px-12 md:grid-cols-[0.8fr_1.2fr] md:gap-16 md:py-16">
			<img src="/flower.png" class="pointer-events-none absolute -bottom-10 -right-4 w-32 rotate-[22deg] opacity-40" aria-hidden="true" />
			<p class="relative text-xs font-bold uppercase tracking-[0.25em] text-[#bd272d]">01 / Manifesto <span class="ml-2 text-2xl">✳</span></p>
			<div class="relative">
				<h2 class="max-w-3xl text-4xl font-extrabold uppercase leading-[0.95] tracking-[-0.05em] sm:text-6xl">The best ideas need room to breathe.</h2>
				<p class="mt-8 max-w-xl text-lg leading-relaxed text-[#385f9d]/80">Flowtea comes from the meeting point between the slow rhythm of tea and creative curiosity. We work with people and brands who want to leave a gentle, recognisable and lasting mark.</p>
			</div>
		</section>

		<section class="mx-auto max-w-7xl border-t border-[#385f9d]/30 py-14">
			<div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
				<div>
					<p class="text-xs font-bold uppercase tracking-[0.25em] text-[#bd272d]">02 / How we work</p>
					<h2 class="mt-4 text-4xl font-extrabold uppercase tracking-[-0.04em] sm:text-5xl">From spark<br />to sip. <span class="text-[#bd272d]">✿</span></h2>
				</div>
				<p class="max-w-xs text-sm leading-relaxed text-[#385f9d]/70">A simple process built on listening, research and little details that make a difference.</p>
			</div>
			<div class="mt-12 grid gap-5 pt-6 sm:grid-cols-3">
				{[
					['We listen', 'We start with you, your world and what you want to bring to life.'],
					['We blend', 'We mix strategy, form and a generous dose of intuition.'],
					['We serve', 'We deliver clear, beautiful ideas ready to move.'],
				].map(([title, description], index) => (
					<article class:list={[
						'rounded-[1.5rem] border-2 border-[#385f9d] p-6 transition-transform hover:rotate-2',
						index === 0 && 'bg-[#bd272d] text-[#f5f1e8] -rotate-2',
						index === 1 && 'bg-[#f7cf35] rotate-2',
						index === 2 && 'bg-[#f5f1e8] -rotate-1',
					]}>
						<span class="text-4xl font-black">{String(index + 1).padStart(2, '0')}</span>
						<h3 class="mt-6 text-xl font-bold">{title}</h3>
						<p class="mt-3 max-w-xs text-sm leading-relaxed opacity-75">{description}</p>
					</article>
				))}
			</div>
		</section>

		<section id="studio" class="relative mx-auto max-w-7xl overflow-hidden border-y border-[#385f9d]/30 py-16">
			<img src="/flower.png" class="pointer-events-none absolute -left-5 top-6 w-28 -rotate-12 opacity-60" aria-hidden="true" />
			<div class="relative grid gap-8 md:grid-cols-3">
				<p class="text-xs font-bold uppercase tracking-[0.25em] text-[#bd272d]">03 / Our infusion</p>
				<p class="text-2xl font-bold leading-tight md:col-span-2 md:max-w-2xl">We give ideas time to open up, like a flower in warm water.</p>
			</div>
			<div class="relative mt-12 grid gap-5 sm:grid-cols-3">
				{['Branding & identity', 'Art direction', 'Web & digital'].map((service, index) => (
					<div class:list={[
						'group min-h-48 rounded-[1.5rem] border-2 border-[#385f9d] bg-[#f5f1e8] p-5 transition-transform hover:-translate-y-2 hover:rotate-2',
						index === 1 ? 'rotate-2' : '-rotate-1',
					]}>
						<span class="text-sm text-[#bd272d]">0{index + 1}</span>
						<h2 class="mt-12 text-xl font-bold leading-tight">{service}</h2>
						<span class="mt-6 block text-2xl transition-transform group-hover:translate-x-2">↗</span>
					</div>
				))}
			</div>
		</section>

		<section class="relative mx-auto max-w-7xl overflow-hidden rounded-[2rem] bg-[#385f9d] px-6 py-14 text-[#f5f1e8] shadow-[10px_10px_0_#bd272d] sm:px-12 sm:py-20">
			<img src="/flower.png" class="pointer-events-none absolute -right-5 -top-8 w-40 rotate-12 opacity-25" aria-hidden="true" />
			<div class="flex flex-col items-start justify-between gap-10 md:flex-row md:items-end">
				<div>
					<p class="text-xs font-bold uppercase tracking-[0.25em] text-[#f7cf35]">04 / The next infusion</p>
					<h2 class="mt-5 max-w-2xl text-5xl font-black uppercase leading-[0.9] tracking-[-0.06em] sm:text-7xl">Have an idea<br />in bloom?</h2>
				</div>
				<a href="mailto:ciao@flowteastudio.it" class="rounded-full bg-[#bd272d] px-7 py-4 text-sm font-bold uppercase tracking-[0.14em] transition-transform hover:-translate-y-1">Write to us <span class="ml-3">↗</span></a>
			</div>
		</section>

		<footer id="contact" class="mx-auto flex max-w-7xl flex-col gap-4 border-t border-[#385f9d]/30 py-8 text-sm sm:flex-row sm:items-center sm:justify-between">
			<p class="font-bold uppercase tracking-[0.16em]">Ready to bloom?</p>
			<a href="mailto:ciao@flowteastudio.it" class="font-bold text-[#bd272d] underline decoration-1 underline-offset-4 hover:text-[#385f9d]">ciao@flowteastudio.it</a>
		</footer>
	</main>
</Layout>
